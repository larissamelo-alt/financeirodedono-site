---
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  titulo: string;
  descricao: string;
  data: Date;
  atualizadoEm?: Date;
  autor: string;
  categoria: string;
  capa?: string;
  slug: string;
  // Perguntas e respostas extraídas da seção "## Perguntas frequentes" do artigo.
  faq?: { pergunta: string; resposta: string }[];
  // Artigos relacionados (mesma categoria ou tags em comum), para links internos.
  relacionados?: { slug: string; titulo: string; categoria: string }[];
}

const {
  titulo,
  descricao,
  data,
  atualizadoEm,
  autor,
  categoria,
  capa,
  slug,
  faq = [],
  relacionados = [],
} = Astro.props;

// Materiais gratuitos mostrados no fim de todo artigo (links internos fixos).
const materiais = [
  { titulo: "Aula gratuita: planejamento financeiro 2027", href: "/conteudos/aula-planejamento-2027" },
  { titulo: "Planilha de fluxo de caixa e DRE gerencial", href: "/conteudos/planilha-fluxo-de-caixa-dre/" },
  { titulo: "Calculadora de capital de giro", href: "/conteudos/capital-de-giro-o-que-e/" },
].filter((m) => !m.href.includes(slug));

const urlArtigo = new URL(`/conteudos/${slug}`, Astro.site).href;

function formatarData(d: Date) {
  return d.toLocaleDateString("pt-BR", {
    day: "2-digit",
    month: "long",
    year: "numeric",
    // As datas do cabeçalho são dias "puros" (sem hora). Fixar UTC evita que
    // o build em outro fuso mostre o dia anterior.
    timeZone: "UTC",
  });
}

// Dados estruturados do artigo (schema.org/Article). É o que permite a uma IA
// citar "segundo o Financeiro de Dono..." com data, autor e título corretos.
const artigoSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: titulo,
  description: descricao,
  datePublished: data.toISOString(),
  dateModified: (atualizadoEm ?? data).toISOString(),
  author:
    autor === "Jonny Elias"
      ? {
          "@type": "Person",
          "@id": "https://www.financeirodedono.com.br/#jonny-elias",
          name: autor,
          url: "https://www.linkedin.com/in/jonnyelias/",
        }
      : { "@type": "Person", name: autor },
  publisher: {
    "@type": "Organization",
    "@id": "https://www.financeirodedono.com.br/#organizacao",
    name: "Financeiro de Dono",
    url: "https://www.financeirodedono.com.br",
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": urlArtigo },
  ...(capa ? { image: new URL(capa, Astro.site).href } : {}),
};

// Perguntas frequentes (schema.org/FAQPage). Só entra quando o artigo tem a
// seção "## Perguntas frequentes" com perguntas em "###".
const faqSchema =
  faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((f) => ({
          "@type": "Question",
          name: f.pergunta,
          acceptedAnswer: { "@type": "Answer", text: f.resposta },
        })),
      }
    : null;

// Trilha de navegação (ajuda o Google a entender a hierarquia do site).
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: Astro.site?.href },
    {
      "@type": "ListItem",
      position: 2,
      name: "Conteúdos",
      item: new URL("/conteudos", Astro.site).href,
    },
    { "@type": "ListItem", position: 3, name: titulo, item: urlArtigo },
  ],
};
---

<BaseLayout titulo={titulo} descricao={descricao} imagem={capa} tipo="article">
  <script type="application/ld+json" set:html={JSON.stringify(artigoSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <main class="mx-auto max-w-3xl px-5 py-12 md:py-16">
    <nav class="mb-8 text-sm text-muted-foreground">
      <a href="/" class="hover:text-foreground">Início</a>
      <span class="mx-2">/</span>
      <a href="/conteudos" class="hover:text-foreground">Conteúdos</a>
    </nav>

    <header class="mb-10">
      <p class="mb-3 text-sm font-medium uppercase tracking-wide text-primary">
        {categoria}
      </p>
      <h1 class="text-3xl font-bold leading-tight text-foreground md:text-4xl">
        {titulo}
      </h1>
      <p class="mt-4 text-lg text-muted-foreground">{descricao}</p>
      <div class="mt-6 flex items-center gap-2 text-sm text-muted-foreground">
        {
          autor === "Jonny Elias" ? (
            <span>
              <strong class="font-medium text-foreground">Jonny Elias</strong>, fundador do
              Financeiro de Dono · ex-CFO, 15 anos em finanças corporativas
            </span>
          ) : (
            <span>{autor}</span>
          )
        }
        <span>·</span>
        <time datetime={data.toISOString()}>{formatarData(data)}</time>
        {
          atualizadoEm && (
            <>
              <span>·</span>
              <span>atualizado em {formatarData(atualizadoEm)}</span>
            </>
          )
        }
      </div>
    </header>

    {
      capa && (
        <img
          src={capa}
          alt={titulo}
          class="mb-10 w-full rounded-xl border border-border"
        />
      )
    }

    <!-- "prose" estiliza automaticamente títulos, listas, links e parágrafos do Markdown -->
    <article
      class="prose prose-neutral max-w-none prose-headings:text-foreground prose-p:text-foreground/90 prose-a:text-primary prose-strong:text-foreground"
    >
      <slot />
    </article>

    {
      relacionados.length > 0 && (
        <nav class="mt-14 border-t border-border pt-8" aria-labelledby="leia-tambem">
          <h2 id="leia-tambem" class="text-xl font-bold text-foreground">Leia também</h2>
          <ul class="mt-4 space-y-3">
            {relacionados.map((r) => (
              <li>
                <a href={`/conteudos/${r.slug}/`} class="font-medium text-primary hover:underline">
                  {r.titulo}
                </a>
                <span class="ml-2 text-sm text-muted-foreground">{r.categoria}</span>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <aside class="mt-10" aria-labelledby="materiais-gratuitos">
      <h2 id="materiais-gratuitos" class="text-xl font-bold text-foreground">Materiais gratuitos</h2>
      <ul class="mt-4 space-y-3">
        {
          materiais.map((m) => (
            <li>
              <a href={m.href} class="font-medium text-primary hover:underline">
                {m.titulo}
              </a>
            </li>
          ))
        }
      </ul>
    </aside>

    <div class="mt-16 rounded-xl border border-border bg-card p-8 text-center">
      <p class="text-lg font-semibold text-foreground">
        Quer enxergar o financeiro da sua empresa com essa clareza?
      </p>
      <p class="mt-2 text-muted-foreground">
        Agende um diagnóstico gratuito de 30 minutos com o Jonny Elias.
      </p>
      <a
        href="https://wa.me/5548996645113?text=Quero%20meu%20diagn%C3%B3stico%20gratuito"
        class="mt-5 inline-block rounded-lg bg-primary px-6 py-3 font-medium text-primary-foreground transition hover:opacity-90"
      >
        Falar com o Financeiro de Dono
      </a>
    </div>
  </main>
</BaseLayout>
