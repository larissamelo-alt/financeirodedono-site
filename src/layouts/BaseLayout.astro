---
import SEO from "@/components/SEO.astro";
import "@/styles/global.css";

interface Props {
  titulo: string;
  descricao: string;
  imagem?: string;
  tipo?: "website" | "article";
}

const { titulo, descricao, imagem, tipo } = Astro.props;

// Dados estruturados da empresa (schema.org). É isto que faz o Google e as IAs
// entenderem QUEM é o autor por trás do conteúdo — e ganharem confiança para citar.
const jonny = {
  "@type": "Person",
  "@id": "https://www.financeirodedono.com.br/#jonny-elias",
  name: "Jonny Elias",
  jobTitle: "Fundador do Financeiro de Dono",
  description:
    "Ex-CFO e COO, com 15 anos em finanças corporativas e gestão de R$ 1,5 bilhão por ano, além de mais de R$ 150 milhões em endividamento corporativo gerido. Professor universitário de finanças, MBA em Gestão Financeira e CPA-20.",
  sameAs: [
    "https://www.linkedin.com/in/jonnyelias/",
    "https://www.instagram.com/jonny.elias/",
    "https://www.youtube.com/@jonnyelias",
  ],
};

const organizacao = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.financeirodedono.com.br/#organizacao",
  name: "Financeiro de Dono",
  legalName: "Financeiro de Dono Consultoria e BPO Financeiro Ltda",
  taxID: "47.318.547/0001-01",
  url: "https://www.financeirodedono.com.br",
  logo: "https://www.financeirodedono.com.br/favicon.png",
  image: "https://www.financeirodedono.com.br/og-image.png",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Florianópolis",
    addressRegion: "SC",
    addressCountry: "BR",
  },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "sales",
    telephone: "+55-48-99664-5113",
    availableLanguage: "Portuguese",
  },
  sameAs: [
    "https://www.instagram.com/financeirodedono/",
    "https://www.linkedin.com/company/financeirodedono/",
  ],
  description:
    "Inteligência financeira aplicada para donos de empresas: BPO Financeiro e CFO sob demanda para quem fatura entre R$ 50 mil e R$ 500 mil por mês.",
  founder: jonny,
  areaServed: "BR",
  knowsAbout: [
    "BPO Financeiro",
    "CFO sob demanda",
    "Fluxo de caixa",
    "DRE",
    "Gestão financeira para clínicas",
    "Gestão financeira para foodservice",
    "Planejamento financeiro",
    "Orçamento empresarial",
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SEO titulo={titulo} descricao={descricao} imagem={imagem} tipo={tipo} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizacao)}
    />
    <!-- Apollo.io: identifica empresas (e pessoas, apenas nos EUA) que visitam o site -->
    <script is:inline>function initApollo(){var n=Math.random().toString(36).substring(7),o=document.createElement("script");o.src="https://assets.apollo.io/micro/website-tracker/tracker.iife.js?nocache="+n,o.async=!0,o.defer=!0,o.onload=function(){window.trackingFunctions.onLoad({appId:"697b83f8fc61850021a51d35"})},document.head.appendChild(o)}initApollo();</script>
  </head>
  <body>
    <slot />
  </body>
</html>
